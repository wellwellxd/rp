# 前端環境變數 —— 只能放「公開可見」的值（會被打包進靜態檔）。
# 絕對不要在這裡放 secret key（sb_secret_...）或舊的 service_role！那些只屬於 Edge Functions。
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase 新金鑰系統的 publishable key（sb_publishable_...，等同舊 anon，可公開）
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 部署到 https://<user>.github.io/<repo>/ 時設定
VITE_BASE=/rp-claude/
